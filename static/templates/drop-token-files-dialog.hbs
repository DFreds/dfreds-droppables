<form id="drop-token-files-dialog">
    <p>{{localize "Droppables.ActorUploadExplanation"}}</p>

    {{#each uploadedData as |data|}}
        <div class="form-group">
            <label>{{data.fileName}}</label>
            <div class="form-fields">
                <select name="type">
                    {{selectOptions data.types selected=data.selectedType}}
                </select>
            </div>
        </div>
    {{/each}}
</form>